# EchoScribe Environment Configuration
# Copy this file to .env and fill in your values

# ─── Required ───
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_anon_key_here
PORT=3000
NODE_ENV=development
CORS_ORIGIN=*

# ─── AI provider keys (all optional) ───
# The shipped reference chain uses whichever of these are present.
# Several Gemini keys (comma-separated or numbered 1_GEMINI_API_KEY, 2_GEMINI_API_KEY)
# form a rotating pool.
GEMINI_API_KEYS=key1,key2
GEMINI_MODEL=gemini-2.0-flash
# Fallback models in order; keys rotate within a model, and the next model is used only when all keys of the current one are exhausted:
# GEMINI_MODELS=gemini-3.5-flash,gemini-3-flash-preview,gemini-3.6-flash
# Same for other vendors: GROQ_MODELS=..., GROQ_STT_MODELS=..., DEEPGRAM_MODELS=...
GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_STT_MODEL=whisper-large-v3
DEEPGRAM_API_KEY=your_deepgram_api_key_here
# DEEPGRAM_MODEL=nova-2

# ─── Per-role provider chains (optional; override the reference chain) ───
# Comma-separated family:model:key triplets, tried top to bottom.
# Omit the key (family:model) to reuse that family's key(s) from above.
# Repeat the same family:model with different keys to form a multi-key pool.
# Families: gemini, groq, deepgram, speechbrain (DIARIZE only, no key)
# ROLE_CHAIN_STT=gemini:gemini-2.0-flash,deepgram:nova-2,groq:whisper-large-v3
# ROLE_CHAIN_DIARIZE=speechbrain:ecapa-tdnn,deepgram:nova-2,gemini:gemini-2.0-flash
# ROLE_CHAIN_ROLE_LABEL=groq:openai/gpt-oss-120b,gemini:gemini-2.0-flash
# ROLE_CHAIN_NOTE_SYNTH=gemini:gemini-2.0-flash,groq:openai/gpt-oss-120b
# ROLE_CHAIN_PROFILE_GEN=gemini:gemini-2.0-flash,groq:openai/gpt-oss-120b
# Routing strategy per role (embedded OmniRoute-style combos):
#   priority | round-robin | random | strict-random | least-used | lkgp
# ROUTING_STRATEGY=priority
# ROLE_STRATEGY_NOTE_SYNTH=round-robin
# Per-role timeout in ms before moving to the next provider:
# ROLE_TIMEOUT_NOTE_SYNTH=120000
# Cooldowns: failing key backs off MIN·2^(n-1) up to MAX; a provider with THRESHOLD
# failures inside WINDOW is skipped for COOLDOWN (local SpeechBrain: _LOCAL_ variants)
# PROVIDER_COOLDOWN_MIN_MS=5000
# PROVIDER_COOLDOWN_MAX_MS=300000
# PROVIDER_BREAKER_API_KEY_FAILURE_THRESHOLD=15
# PROVIDER_BREAKER_API_KEY_FAILURE_WINDOW_MS=1800000
# PROVIDER_BREAKER_API_KEY_COOLDOWN_MS=600000

# ─── Synced API keys ───
# Encrypts the provider keys users choose to "Sync to my account" (32+ random characters).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PROVIDER_KEYS_SECRET=

# ─── Optional services ───
SPEECHBRAIN_URL=http://localhost:5050
RESEND_API_KEY=your_resend_api_key_here
