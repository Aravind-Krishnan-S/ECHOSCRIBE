# EchoScribe Environment Configuration
# Copy this file to .env and fill in your values

# ─── Required ───
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_anon_key_here
PORT=3000
NODE_ENV=development
CORS_ORIGIN=*

# ─── OmniRoute (recommended) ───
# When OMNIROUTE_API_KEY is set, every AI role makes ONE call to OmniRoute and
# OmniRoute's combos do the model switching (https://github.com/diegosouzapw/OmniRoute).
# Diarization stays on the local SpeechBrain service. The direct keys below are then unused.
# OMNIROUTE_URL=http://localhost:20128/v1
# OMNIROUTE_API_KEY=your_omniroute_key       # Dashboard → Endpoints
# OMNIROUTE_MODEL=auto                       # combo/model for all text roles
# OMNIROUTE_MODEL_NOTE_SYNTH=echoscribe-notes  # optional per-role combo (also _ROLE_LABEL, _PROFILE_GEN)
# OMNIROUTE_MODEL_STT=groq/whisper-large-v3  # transcription model or combo

# ─── Direct AI provider keys (used only when OmniRoute is not configured) ───
# The shipped reference chain uses whichever of these are present.
# Several Gemini keys (comma-separated or numbered 1_GEMINI_API_KEY, 2_GEMINI_API_KEY)
# form a rotating pool.
GEMINI_API_KEYS=key1,key2
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_STT_MODEL=whisper-large-v3
DEEPGRAM_API_KEY=your_deepgram_api_key_here
# DEEPGRAM_MODEL=nova-2

# ─── Per-role provider chains (optional; override the reference chain) ───
# Comma-separated family:model:key triplets, tried top to bottom.
# Omit the key (family:model) to reuse that family's key(s) from above.
# Repeat the same family:model with different keys to form a multi-key pool.
# Families: gemini, groq, deepgram, speechbrain (DIARIZE only, no key)
# ROLE_CHAIN_STT=gemini:gemini-2.0-flash,deepgram:nova-2,groq:whisper-large-v3
# ROLE_CHAIN_DIARIZE=speechbrain:ecapa-tdnn,deepgram:nova-2,gemini:gemini-2.0-flash
# ROLE_CHAIN_ROLE_LABEL=groq:openai/gpt-oss-120b,gemini:gemini-2.0-flash
# ROLE_CHAIN_NOTE_SYNTH=gemini:gemini-2.0-flash,groq:openai/gpt-oss-120b
# ROLE_CHAIN_PROFILE_GEN=gemini:gemini-2.0-flash,groq:openai/gpt-oss-120b
# Per-role timeout in ms before moving to the next provider:
# ROLE_TIMEOUT_NOTE_SYNTH=120000

# ─── Optional services ───
SPEECHBRAIN_URL=http://localhost:5050
RESEND_API_KEY=your_resend_api_key_here
